# Copie para .env e preencha o que for usar.
# Tudo tem default funcional: sem chave de API o projeto roda com o
# embedder de hashing e os testes passam sem banco nem Redis.

# --- Modelo (API Anthropic) ---
ANTHROPIC_API_KEY=
MODEL_PRIMARY=claude-haiku-4-5-20251001
MODEL_ESCALATION=claude-sonnet-4-6
MODEL_MAX_TOKENS=1024

# --- Embeddings ---
# hashing (padrão, determinístico, sem rede) | openai (ou endpoint compatível)
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIM=1536

# --- Infra ---
DATABASE_URL=postgresql://atendo_app:atendo_app@localhost:5432/atendo
REDIS_URL=redis://localhost:6379/0
TENANTS_DIR=tenants

# --- Cache semântico e rate limit ---
CACHE_SIMILARITY_THRESHOLD=0.96
CACHE_TTL_SECONDS=86400
RATE_LIMIT_PER_MINUTE=30

# --- Observabilidade (OpenTelemetry) ---
OTEL_ENABLED=false
OTEL_SERVICE_NAME=atendo
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- WhatsApp Cloud API ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App Secret da Meta: assina o corpo do webhook (X-Hub-Signature-256).
WHATSAPP_APP_SECRET=
